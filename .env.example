# ---- MongoDB ---------------------------------------------------------------
# Local MongoDB (default):
MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas (cloud) - see docs/ATLAS_SETUP.md:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGO_DB_NAME=pkdp_db

# ---- Architecture switches (all optional) ----------------------------------
# Send Streamlit's logging / scoring / search / LLM calls to the FastAPI backend
# (start it with: python scripts/run_api.py, or everything with: python scripts/start_all.py)
# RETENT_API_URL=http://127.0.0.1:8000

# Build the RAG pipeline with LangChain (pip install langchain-core langchain-ollama)
# RETENT_USE_LANGCHAIN=1

# Automatic practice preparation when recall falls below 65%  (1 = on, 0 = off)
# RETENT_AUTOGEN=1

# Which local model to prefer, first installed one wins
# RETENT_LLM=llama3.2:3b,qwen2.5:3b,mistral
